# All optional. Copy to .env for docker compose, or set these in Coolify's Environment Variables tab.

# Set one if Spool is ever reachable beyond your home network.
SPOOL_PASSWORD=
# Highest resolution to fetch. 720 roughly halves the file size.
SPOOL_MAX_HEIGHT=1080
# Downloads at once.
SPOOL_CONCURRENCY=1
# Hours after you finish a video before its file is deleted. 0 keeps files forever.
SPOOL_DELETE_WATCHED_AFTER_HOURS=24
# SponsorBlock categories to cut out, e.g. sponsor,selfpromo,interaction
SPOOL_SPONSORBLOCK=
# Set 0 to skip the yt-dlp self-update at startup.
SPOOL_YTDLP_AUTOUPDATE=1
# Path inside the container to a Netscape cookies.txt, e.g. /data/cookies.txt
SPOOL_COOKIES=
# Extra raw yt-dlp flags, space separated.
SPOOL_YTDLP_ARGS=
